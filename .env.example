# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=orelia
DB_PASSWORD=orelia
DB_NAME=orelia
# Set true when DB_HOST points at RDS or another managed Postgres that
# requires SSL (most do by default) -- leave false for the local
# docker-compose Postgres container, which has no SSL configured.
DB_SSL=false

# Backend
PORT=3001
NODE_ENV=development
# Raw SQL query logging — leave false; flip to true only when debugging a
# specific query. The [HTTP] request logger covers normal terminal visibility.
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS — comma-separated origins allowed to make credentialed (cookie) requests
CORS_ORIGIN=http://localhost:3000

# Shared app S3 bucket -- DB backups (nightly pg_dump, platform-admin manual
# trigger) AND every file upload (logo, deal documents, employee photo/CV,
# certification evidence) both use this bucket, kept apart by key prefix
# (db-backups/orelia/ vs uploads/). Uploads fail loudly if these are unset.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BACKUPS_BUCKET=
BACKUP_RETENTION_DAYS=7
NIGHTLY_BACKUP_HOUR=2
# PG_DUMP_PATH=pg_dump
# NIGHTLY_BACKUP_DISABLED=1

# Transactional email (SendGrid) -- sends the "your account was created"
# welcome email. Left unset, MailService just logs a warning and skips
# sending instead of failing user creation.
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=NEXUS CRM
# Frontend's public origin, used to build the login link in the welcome
# email -- not the backend's own URL (see NEXT_PUBLIC_API_URL above).
APP_BASE_URL=http://localhost:3000

# Exchange-rate provider (exchangerate-api.com v6) for the Sales Pipeline
# Dashboard's cross-currency KPIs. Left unset, the daily refresh just logs a
# warning and no-ops instead of failing anything.
FX_RATE_API_KEY=
FX_RATE_API_BASE_URL=https://v6.exchangerate-api.com/v6

# Trusted reverse-proxy hops in front of this app -- 0 means don't trust
# X-Forwarded-For at all (the default, local docker-compose has no proxy).
# Only raise this in an environment with a real proxy (e.g. nginx) actually
# in front, so the Activity Log's captured sign-in IP is the real client's.
TRUST_PROXY_HOPS=0
