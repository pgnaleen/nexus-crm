# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=orelia
DB_PASSWORD=orelia
DB_NAME=orelia

# Backend
PORT=3001
NODE_ENV=development
# Raw SQL query logging — leave false; flip to true only when debugging a
# specific query. The [HTTP] request logger covers normal terminal visibility.
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS — comma-separated origins allowed to make credentialed (cookie) requests
CORS_ORIGIN=http://localhost:3000

# DB backups (nightly pg_dump -> S3, platform-admin manual trigger)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BACKUPS_BUCKET=
BACKUP_RETENTION_DAYS=7
NIGHTLY_BACKUP_HOUR=2
# PG_DUMP_PATH=pg_dump
# NIGHTLY_BACKUP_DISABLED=1
